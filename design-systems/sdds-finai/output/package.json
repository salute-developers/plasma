{
    "name": "@sddsjs/finai",
    "version": "0.1.2",
    "description": "SDDS by Design System Builder / React UI kit for web applications",
    "license": "MIT",
    "keywords": [
        "design-system",
        "react-components",
        "ui-kit",
        "react"
    ],
    "files": [
        "styled-components",
        "components",
        "es",
        "theme",
        "css",
        "index.css",
        "index.d.ts",
        "index.js",
        "index.js.map",
        "_virtual"
    ],
    "main": "index.js",
    "module": "es/index.js",
    "types": "index.d.ts",
    "dependencies": {
        "@salutejs/plasma-new-hope": "latest"
    },
    "peerDependencies": {
        "react": ">=16.13.1",
        "react-dom": ">=16.13.1",
        "styled-components": "^5.3.1 || ^6.0.0"
    },
    "devDependencies": {
        "@babel/cli": "8.0.6",
        "@babel/core": "8.0.10",
        "@babel/plugin-proposal-class-properties": "7.18.6",
        "@babel/plugin-transform-class-properties": "8.0.1",
        "@babel/plugin-transform-react-constant-elements": "8.0.5",
        "@babel/preset-env": "8.0.7",
        "@babel/preset-react": "8.0.1",
        "@babel/preset-typescript": "8.0.7",
        "@ironkinoko/rollup-plugin-styles": "^4.0.3",
        "@linaria/core": "8.2.0",
        "@linaria/react": "8.2.0",
        "@linaria/rollup": "5.0.4",
        "@microsoft/api-extractor": "7.60.1",
        "@rollup/plugin-babel": "^7.0.0",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@salutejs/plasma-colors": "0.27.0",
        "@salutejs/plasma-core": "1.248.0",
        "@salutejs/plasma-cy-utils": "0.178.0",
        "@salutejs/plasma-icons": "1.256.0",
        "@salutejs/plasma-sb-utils": "0.250.0",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/styled-components": "5.1.36",
        "babel-loader": "10.1.1",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "babel-plugin-styled-components": "2.3.1",
        "default-browser-id": "5.0.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "rollup": "^4.0.0",
        "styled-components": "^6.0.0",
        "vite": "4.5.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepare": "npm run build",
        "postpack": "git check-ignore -q . 2>/dev/null; test $? = 1 && git clean -fdX -e \"!*.tgz\" . || true",
        "prebuild": "rm -rf ./components ./es ./tokens ./theme ./css ./index.*",
        "prebuild:css": "rm -rf src-css && ./scripts/copy-linaria-components.sh",
        "build": "CSS_BUILD_PATH=css npm run copy-css-files && npm run build:css",
        "postbuild": "npm run generate:typings",
        "build:css": "BABEL_ENV=esm SC_NAMESPACE=finai rollup -c",
        "postbuild:css": "rm -rf src-css",
        "pregenerate:typings": "rm -rf components/**/*.d.ts && rm -f index.d.ts",
        "generate:typings": "tsc --outDir . --emitDeclarationOnly",
        "copy-css-files": "mkdir -p ${CSS_BUILD_PATH} && cp -R src/theme/css/* ${CSS_BUILD_PATH}"
    },
    "sideEffects": [
        "*.css"
    ]
}