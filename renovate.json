{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "baseBranchPatterns": ["dev", "master"],
    "prHourlyLimit": 2,
    "schedule": ["* 0-3 */2 * *"],
    "rebaseWhen": "never",
    "ignoreDeps": ["react", "react-dom", "cypress", "node", "npm", "lerna", "typescript", "eslint"],
    "packageRules": [
        {
            "description": "Group regular dependency updates into one PR to dev",
            "matchBaseBranches": ["dev"],
            "groupName": "all dependencies",
            "groupSlug": "all",
            "groupSingleUpdates": true,
            "separateMajorMinor": false,
            "rebaseWhen": "auto"
        },
        {
            "description": "Disable regular dependency updates on master",
            "matchBaseBranches": ["master"],
            "enabled": false
        },
        {
            "description": "Update new scoped themes through master only",
            "matchBaseBranches": ["dev"],
            "matchPackageNames": ["@sddsjs/sdds_*"],
            "enabled": false
        },
        {
            "description": "Keep new scoped themes dependencies pinned to the npm latest tag in one PR to master",
            "matchBaseBranches": ["master"],
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@sddsjs/sdds_*"],
            "enabled": true,
            "followTag": "latest",
            "rangeStrategy": "pin",
            "groupName": "sddsjs themes",
            "groupSlug": "sddsjs-themes",
            "groupSingleUpdates": true,
            "separateMajorMinor": false,
            "schedule": ["* * * * *"],
            "prCreation": "immediate",
            "rebaseWhen": "auto",
            "automerge": false
        }
    ]
}
