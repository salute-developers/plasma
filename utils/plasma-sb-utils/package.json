{
  "name": "@salutejs/plasma-sb-utils",
  "version": "0.240.0",
  "description": "Code shared between ui libraries.",
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./managerVersions": {
      "types": "./lib/managerVersions.d.ts",
      "default": "./lib/managerVersions.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "utils/plasma-sb-utils"
  },
  "scripts": {
    "prepare": "npm run build",
    "generate:api-props": "node scripts/generate-api-props.js",
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "rm -rf lib",
    "lint": "../../node_modules/.bin/eslint ./src --ext .ts,.tsx --quiet"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@salutejs/plasma-colors": "0.20.0",
    "@salutejs/plasma-core": "1.239.0",
    "@salutejs/plasma-icons": "1.247.0",
    "@storybook/react": "10.3.4",
    "param-case": "^3.0.4"
  },
  "peerDependencies": {
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1",
    "styled-components": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/styled-components": "^5.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "5.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["lib"]
}
