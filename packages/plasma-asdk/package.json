{
  "name": "@salutejs/plasma-asdk",
  "version": "0.401.1",
  "description": "Salute Design System / React UI kit for Assistant web applications",
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": ["design-system", "react-components", "ui-kit", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "packages/plasma-asdk"
  },
  "main": "index.js",
  "module": "es/index.js",
  "types": "index.d.ts",
  "peerDependencies": {
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1",
    "styled-components": "^5.3.11 || ^6.0.0"
  },
  "dependencies": {
    "@salutejs/plasma-new-hope": "0.387.1",
    "@salutejs/plasma-tokens": "1.159.0",
    "@salutejs/plasma-tokens-b2b": "1.71.0",
    "@salutejs/plasma-typo": "0.59.0"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.10",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-react-constant-elements": "8.0.5",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@salutejs/plasma-colors": "0.27.0",
    "@salutejs/plasma-core": "1.248.0",
    "@salutejs/plasma-cy-utils": "0.178.0",
    "@salutejs/plasma-icons": "1.256.0",
    "@salutejs/plasma-sb-utils": "0.250.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/styled-components": "5.1.36",
    "babel-loader": "10.1.1",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "babel-plugin-styled-components": "2.3.1",
    "default-browser-id": "5.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "6.6.0",
    "typescript-coverage-report": "2.1.2"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "rm -rf ./components ./es ./helpers ./hocs ./hooks ./mixins ./tokens ./types ./utils index.d.ts index.d.ts.map index.js index.js.map",
    "build": "npm run build:cjs && npm run build:esm",
    "postbuild": "npm run generate:typings",
    "build:cjs": "BABEL_ENV=cjs SC_NAMESPACE=plasma-web babel ./src --out-dir . --extensions .ts,.tsx",
    "build:esm": "BABEL_ENV=esm SC_NAMESPACE=plasma-web babel ./src --out-dir ./es --extensions .ts,.tsx",
    "generate:typings": "tsc --outDir . --emitDeclarationOnly",
    "storybook": "storybook dev -p ${PORT:-7007} -c .storybook",
    "storybook:build": "storybook build -c .storybook -o build-sb",
    "typescript-coverage": "npx typescript-coverage-report > /dev/null",
    "lint": "../../node_modules/.bin/eslint ./src --ext .js,.ts,.tsx --quiet"
  },
  "typeCoverage": {
    "ignoreFiles": ["src/**/*component-test.tsx", "src/**/*stories.tsx", "src/**/*perftest.tsx"],
    "atLeast": 99.96
  },
  "contributors": ["salute.developers@gmail.com"],
  "sideEffects": false
}
