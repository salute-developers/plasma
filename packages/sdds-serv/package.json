{
  "name": "@salutejs/sdds-serv",
  "version": "0.361.0-dev.0",
  "description": "Salute Design System / React UI kit for SDDS SERV web applications",
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "keywords": [
    "design-system",
    "react-components",
    "ui-kit",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "packages/sdds-serv"
  },
  "exports": {
    ".": {
      "import": "./dist/css/es/index.js",
      "require": "./dist/css/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./styled-components": {
      "import": "./dist/styled-components/es/index.js",
      "require": "./dist/styled-components/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./emotion": {
      "import": "./dist/emotion/es/index.js",
      "require": "./dist/emotion/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/css/es/index.js",
      "require": "./dist/ai/css/cjs/index.js",
      "types": "./types/ai.d.ts"
    },
    "./ai/styled-components": {
      "import": "./dist/ai/styled-components/es/index.js",
      "require": "./dist/ai/styled-components/cjs/index.js",
      "types": "./types/ai.d.ts"
    },
    "./ai/emotion": {
      "import": "./dist/ai/emotion/es/index.js",
      "require": "./dist/ai/emotion/cjs/index.js",
      "types": "./types/ai.d.ts"
    }
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1",
    "styled-components": "^5.3.1"
  },
  "dependencies": {
    "@salutejs/plasma-new-hope": "0.374.0-dev.0",
    "@salutejs/sdds-themes": "0.75.0-dev.0"
  },
  "devDependencies": {
    "@babel/cli": "7.24.1",
    "@babel/core": "7.24.4",
    "@babel/plugin-transform-class-properties": "7.24.1",
    "@babel/plugin-transform-react-constant-elements": "7.24.1",
    "@babel/preset-env": "7.24.4",
    "@babel/preset-react": "7.24.1",
    "@babel/preset-typescript": "7.24.1",
    "@emotion/babel-plugin": "11.11.0",
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@ironkinoko/rollup-plugin-styles": "^4.0.3",
    "@linaria/core": "5.0.2",
    "@linaria/react": "5.0.3",
    "@linaria/rollup": "5.0.4",
    "@linaria/vite": "5.0.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@salutejs/plasma-colors": "0.18.0-dev.0",
    "@salutejs/plasma-core": "1.237.0-dev.0",
    "@salutejs/plasma-cy-utils": "0.167.0-dev.0",
    "@salutejs/plasma-icons": "1.245.0-dev.0",
    "@salutejs/plasma-sb-utils": "0.238.0-dev.0",
    "@types/node": "16.7.13",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/styled-components": "5.1.0",
    "babel-loader": "8.2.2",
    "babel-plugin-annotate-pure-calls": "0.4.0",
    "babel-plugin-styled-components": "1.13.2",
    "default-browser-id": "2.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "styled-components": "5.3.1",
    "typescript-coverage-report": "0.7.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:css && npm run build:styled-components && npm run build:emotion",
    "postbuild": "npm run generate:typings",
    "prebuild:css": "rm -rf src-css && ./scripts/copy-linaria-components.sh",
    "build:css": "rm -rf dist/css dist/ai/css && rollup -c",
    "postbuild:css": "rm -rf src-css",
    "prebuild:styled-components": "rm -rf src-styled-components src-ai && cp -R src src-styled-components && rm -rf src-styled-components/components/_ai && mkdir -p src-ai/components && cp -R src/components/_ai src-ai/components/_ai && cp src/ai.ts src-ai/index.ts",
    "build:styled-components": "rm -rf dist/styled-components dist/ai/styled-components && npm run build:styled-components:esm && npm run build:styled-components:cjs",
    "build:styled-components:cjs": "swc ./src-styled-components -d ./dist/styled-components/cjs --strip-leading-paths --config-file ../../swc.config.json -C module.type=commonjs && swc ./src-ai -d ./dist/ai/styled-components/cjs --strip-leading-paths --config-file ../../swc.config.json -C module.type=commonjs",
    "build:styled-components:esm": "swc ./src-styled-components -d ./dist/styled-components/es --strip-leading-paths --config-file ../../swc.config.json -C module.type=es6 && swc ./src-ai -d ./dist/ai/styled-components/es --strip-leading-paths --config-file ../../swc.config.json -C module.type=es6",
    "postbuild:styled-components": "rm -rf src-styled-components src-ai",
    "prebuild:emotion": "rm -rf src-emotion src-ai-emotion && cp -R src src-emotion && rm -rf src-emotion/components/_ai && node ./scripts/replaceStyledComponentsToEmotion.js && mkdir -p src-ai-emotion/components && cp -R src/components/_ai src-ai-emotion/components/_ai && cp src/ai.ts src-ai-emotion/index.ts && node ./scripts/replaceStyledComponentsToEmotion.js src-ai-emotion",
    "build:emotion": "rm -rf dist/emotion dist/ai/emotion && npm run build:emotion:esm && npm run build:emotion:cjs && swc ./src-ai-emotion -d ./dist/ai/emotion/es --strip-leading-paths --config-file ../../swc.config.json -C module.type=es6 && swc ./src-ai-emotion -d ./dist/ai/emotion/cjs --strip-leading-paths --config-file ../../swc.config.json -C module.type=commonjs",
    "build:emotion:cjs": "swc ./src-emotion -d ./dist/emotion/cjs --strip-leading-paths --config-file ../../swc.config.json -C module.type=commonjs",
    "build:emotion:esm": "swc ./src-emotion -d ./dist/emotion/es --strip-leading-paths --config-file ../../swc.config.json -C module.type=es6",
    "postbuild:emotion": "rm -rf src-emotion src-ai-emotion",
    "generate:typings": "rm -rf types && tsc",
    "storybook": "storybook dev -p ${PORT:-7002} -c .storybook",
    "storybook:build": "storybook build -c .storybook -o build-sb",
    "typescript-coverage": "npx typescript-coverage-report > /dev/null",
    "lint": "../../node_modules/.bin/eslint ./src --ext .js,.ts,.tsx --quiet"
  },
  "typeCoverage": {
    "ignoreFiles": [
      "src/**/*.component-test.tsx",
      "src/**/*.stories.tsx",
      "src/**/*.styles.ts"
    ],
    "atLeast": 99.9
  },
  "contributors": [
    "salute.developers@gmail.com"
  ],
  "sideEffects": [
    "*.css"
  ]
}