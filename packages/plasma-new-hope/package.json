{
  "name": "@salutejs/plasma-new-hope",
  "version": "0.387.1",
  "description": "Salute Design System blueprint",
  "exports": {
    ".": {
      "import": "./dist/styled-components/es/index.js",
      "require": "./dist/styled-components/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./styled-components": {
      "import": "./dist/styled-components/es/index.js",
      "require": "./dist/styled-components/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./emotion": {
      "import": "./dist/emotion/es/index.js",
      "require": "./dist/emotion/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./css": {
      "import": "./dist/css/es/index.js",
      "require": "./dist/css/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./beta": {
      "import": "./dist/beta/es/index.js",
      "require": "./dist/beta/cjs/index.js",
      "types": "./dist/beta/types/components/_beta/index.d.ts"
    },
    "./types/*": "./types/*"
  },
  "files": ["dist", "types"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:css && npm run build:beta && npm run build:styled-components && npm run build:emotion",
    "postbuild": "npm run generate:typings",
    "build:styled-components": "rm -rf dist/styled-components && npm run build:styled-components:esm && npm run build:styled-components:cjs",
    "build:styled-components:cjs": "swc ./src -d ./dist/styled-components/cjs --strip-leading-paths --ignore '**/examples/**,**/components/_beta/**' --config-file ./swc-sc.config.json -C module.type=commonjs",
    "build:styled-components:esm": "swc ./src -d ./dist/styled-components/es --strip-leading-paths --ignore '**/examples/**,**/components/_beta/**' --config-file ./swc-sc.config.json -C module.type=es6",
    "postbuild:styled-components": "node ./scripts/stripAnnotations.mjs dist/styled-components",
    "prebuild:emotion": "rm -rf src-emotion && cp -R src src-emotion && node ./scripts/replaceImports.mjs --mode emotion",
    "build:emotion": "rm -rf dist/emotion && npm run build:emotion:esm && npm run build:emotion:cjs",
    "build:emotion:cjs": "swc ./src-emotion -d ./dist/emotion/cjs --strip-leading-paths --ignore '**/examples/**,**/components/_beta/**' --config-file ./swc-emotion.config.json -C module.type=commonjs",
    "build:emotion:esm": "swc ./src-emotion -d ./dist/emotion/es --strip-leading-paths --ignore '**/examples/**,**/components/_beta/**' --config-file ./swc-emotion.config.json -C module.type=es6",
    "postbuild:emotion": "rm -rf src-emotion && node ./scripts/stripAnnotations.mjs dist/emotion",
    "prebuild:css": "rm -rf src-css && cp -R src src-css && node ./scripts/replaceImports.mjs --mode css",
    "build:css": "rm -rf dist/css && rollup -c",
    "postbuild:css": "rm -rf src-css && node ./scripts/stripAnnotations.mjs dist/css",
    "build:beta": "rm -rf dist/beta && rollup -c rollup.beta.config.mjs",
    "generate:typings": "tsc && tsc-alias && tsc -p src/components/_beta/tsconfig.json",
    "storybook": "storybook dev -p ${PORT:-7002} -c .storybook",
    "storybook:ai-components": "USE_AI_COMPONENTS=true storybook dev -p ${PORT:-7002} -c .storybook",
    "storybook:build": "storybook build -c .storybook -o build-sb",
    "storybook:build:ai-components": "USE_AI_COMPONENTS=true storybook build -c .storybook -o ai-components-build-sb",
    "lint": "../../node_modules/.bin/eslint ./src --ext .js,.ts,.tsx --quiet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "packages/plasma-new-hope"
  },
  "keywords": ["design-system", "ui-kit", "react"],
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/salute-developers/plasma/issues"
  },
  "homepage": "https://github.com/salute-developers/plasma#readme",
  "peerDependencies": {
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.10",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-react-constant-elements": "8.0.5",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@emotion/babel-plugin": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@ironkinoko/rollup-plugin-styles": "^4.0.3",
    "@linaria/rollup": "5.0.4",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@salutejs/plasma-cy-utils": "0.178.0",
    "@salutejs/plasma-sb-utils": "0.250.0",
    "@salutejs/plasma-themes": "0.69.0",
    "@types/lodash": "^4.14.191",
    "@types/lodash.chunk": "4.2.9",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@types/styled-components": "5.1.36",
    "babel-loader": "10.1.1",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-styled-components": "2.3.1",
    "csstype": "3.2.3",
    "default-browser-id": "5.0.1",
    "katex": "0.19.1",
    "marked-katex-extension": "5.1.13",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rollup": "^4.0.0",
    "styled-components": "6.6.0",
    "tsc-alias": "1.9.9"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/react": "0.27.20",
    "@floating-ui/react-dom": "2.1.9",
    "@linaria/core": "8.2.0",
    "@linaria/react": "8.2.0",
    "@popperjs/core": "2.11.8",
    "@salutejs/input-core": "2.2.0",
    "@salutejs/plasma-typo": "0.59.0",
    "@salutejs/react-maskinput": "3.4.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "classnames": "2.5.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "focus-visible": "5.2.1",
    "lodash.chunk": "4.2.0",
    "lodash.throttle": "4.1.1",
    "marked": "18.1.2",
    "rc-tree": "5.13.1",
    "re-resizable": "6.11.2",
    "react-draggable": "4.7.2",
    "react-hot-toast": "2.6.1",
    "react-number-format": "5.4.5",
    "react-popper": "2.3.0",
    "react-syntax-highlighter": "16.1.2",
    "storeon": "3.1.5"
  },
  "sideEffects": ["*.css"]
}
