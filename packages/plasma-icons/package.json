{
  "name": "@salutejs/plasma-icons",
  "version": "1.256.0",
  "description": "Salute Design System Icons",
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "Icon.assets",
    "Icons",
    "index.d.ts",
    "index.js",
    "Icon.d.ts",
    "Icon.js",
    "IconRoot.d.ts",
    "IconRoot.js",
    "es",
    "scalable",
    "old",
    "css",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "packages/plasma-icons"
  },
  "exports": {
    ".": {
      "import": "./es/index.js",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./16": {
      "import": "./es/scalable/index.16.js",
      "require": "./scalable/index.16.js",
      "types": "./scalable/index.16.d.ts"
    },
    "./24": {
      "import": "./es/scalable/index.24.js",
      "require": "./scalable/index.24.js",
      "types": "./scalable/index.24.d.ts"
    },
    "./36": {
      "import": "./es/scalable/index.36.js",
      "require": "./scalable/index.36.js",
      "types": "./scalable/index.36.d.ts"
    },
    "./css": {
      "import": "./css/es/index.js",
      "require": "./css/cjs/index.js",
      "types": "./index.d.ts"
    },
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=16.13.1",
    "react-dom": ">=16.13.1",
    "styled-components": "^5.3.11 || ^6.0.0"
  },
  "dependencies": {
    "@linaria/core": "8.2.0",
    "@linaria/react": "8.2.0"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/plugin-transform-react-constant-elements": "8.0.5",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@ironkinoko/rollup-plugin-styles": "^4.0.3",
    "@linaria/babel-preset": "^5.0.4",
    "@linaria/rollup": "^5.0.4",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/pluginutils": "^5.1.2",
    "@types/node": "^26.0.0",
    "@types/prettier": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/styled-components": "^5.1.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "babel-plugin-styled-components": "^2.0.0",
    "fast-glob": "^3.3.2",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-css-only": "^4.5.2",
    "sharp": "^0.35.0",
    "styled-components": "6.6.0",
    "svg2vectordrawable": "^2.9.1",
    "vite": "4.5.3"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "rm -rf ./css/es ./css/cjs ./es ./Icon* ./index.* ./old ./scalable ./scripts-build ./src-build ./android-icons ./src-rn-build && cp -r ./src ./src-build && cp -r ./src/scalable ./src-rn-build",
    "prebuild:css": "node ./scripts/replaceScToLinaria.mjs",
    "build": "npm run generate:react && npm run build:cjs && npm run build:esm && npm run build:css",
    "postbuild": "tsc --outDir . --emitDeclarationOnly",
    "generate:android": "npm run build:scripts && node ./scripts-build/generateAndroidArchive.js && zip -r ./archives/android-icons.zip android-icons",
    "generate:react": "npm run build:scripts && node ./scripts-build/generateReactComponents.js",
    "generate:react-native": "npm run build:scripts && node ./scripts-build/generateReactNativeComponents.js && rm -rf ./src-rn-build/Icon.svg.* ./src-rn-build/Icon*.tsx",
    "generate:ios": "node ./scripts/generateIconsIos.mjs",
    "build:scripts": "BABEL_ENV=cjs babel ./scripts --out-dir ./scripts-build --extensions .ts,.tsx",
    "build:cjs": "swc ./src-build -d . --strip-leading-paths -C module.type=commonjs --config-file ../../swc.config.json",
    "build:esm": "swc ./src-build -d ./es --strip-leading-paths -C module.type=es6 --config-file ../../swc.config.json",
    "build:css": "rollup -c",
    "lint": "../../node_modules/.bin/eslint ./src --ext .js,.ts,.tsx --quiet"
  },
  "contributors": ["salute.developers@gmail.com"],
  "sideEffects": ["*.css"]
}
