{
  "name": "@salutejs/sdds-icons",
  "version": "0.1.0",
  "description": "SDDS icons",
  "author": "Salute Frontend Team <salute.developers@gmail.com>",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE.txt"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salute-developers/plasma.git",
    "directory": "packages/sdds-icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./16": {
      "types": "./dist/16/index.d.ts",
      "import": "./dist/16/index.js"
    },
    "./16/*": {
      "types": "./dist/16/*.d.ts",
      "import": "./dist/16/*.js"
    },
    "./24": {
      "types": "./dist/24/index.d.ts",
      "import": "./dist/24/index.js"
    },
    "./24/*": {
      "types": "./dist/24/*.d.ts",
      "import": "./dist/24/*.js"
    },
    "./36": {
      "types": "./dist/36/index.d.ts",
      "import": "./dist/36/index.js"
    },
    "./36/*": {
      "types": "./dist/36/*.d.ts",
      "import": "./dist/36/*.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/types": "7.29.7",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@types/react": "18.0.28",
    "prettier": "2.0.5",
    "react": "18.2.0"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node ./scripts/build.mjs"
  },
  "sideEffects": false,
  "contributors": ["salute.developers@gmail.com"]
}
